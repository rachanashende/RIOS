# Copy this file to .env before running the server.

# Your Postgres connection string.
# In Supabase: click the green "Connect" button in the top bar of your
# project dashboard (not Settings > Database — that page moved), choose
# the "Transaction pooler" tab, and copy the string shown there. It looks
# like:
#   postgres://postgres.xxxxxxxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres
# Replace [YOUR-PASSWORD] with your database password (set when the
# project was created — resettable from the same Connect panel).
# SSL is enabled automatically for any supabase.co/supabase.com host;
# nothing else to configure.
DATABASE_URL=postgres://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres

JWT_SECRET=change-this-to-a-long-random-string
PORT=4000

# --- Email (verification + password reset) ---
# Sign up free at resend.com, create an API key, paste it here.
# Without this set, the backend logs a warning and skips sending instead
# of crashing — verification/reset links just won't go anywhere until
# it's configured.
RESEND_API_KEY=

# Until you verify a custom domain in Resend, this default sender can
# only actually deliver to the email address of the Resend account
# itself — fine for testing, not for real client emails yet.
EMAIL_FROM=RIOS <onboarding@resend.dev>

# Public URL of the deployed frontend — used to build the links inside
# verification/reset emails. Leave as-is for local dev; set to your
# Render static site URL in production.
APP_URL=http://localhost:5173

